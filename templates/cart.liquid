{%- assign sea_salt = settings.product_sea_salt | default: all_products['aegean-sea-salt'] -%}
<section class="section-wrap cart-page" aria-labelledby="cart-heading">
  <p class="eyebrow">YOUR BOX</p>
  <h1 id="cart-heading">Your <em>cart.</em></h1>
  {%- if cart.item_count == 0 -%}
    <div class="cart-empty">
      <p>Nothing in here yet. A box of Aegean Sea Salt fixes that.</p>
      <div class="hero-actions">
        {%- if sea_salt != blank -%}<a class="button" href="{{ sea_salt.url }}">Shop Aegean Sea Salt <span aria-hidden="true">↗</span></a>{%- else -%}<a class="button" href="{{ routes.root_url }}#chips">Meet the chips <span aria-hidden="true">↗</span></a>{%- endif -%}
        <a class="text-link" href="{{ routes.root_url }}#find">Find Zeus near you</a>
      </div>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form" novalidate>
      <ul class="cart-lines">
        {%- for item in cart.items -%}
          <li class="cart-line">
            <a class="cart-line-art" href="{{ item.url }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.image.alt | escape }}" width="120" height="150" loading="lazy">
              {%- else -%}
                <img src="{{ 'zeus-aegean-sea-salt.webp' | asset_url }}" alt="" width="120" height="150" loading="lazy">
              {%- endif -%}
            </a>
            <div class="cart-line-copy">
              <a class="cart-line-title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="cart-line-variant">{{ item.variant.title | escape }}</p>{%- endunless -%}
              {%- if item.selling_plan_allocation -%}
                <p class="cart-line-plan"><span aria-hidden="true">↻</span> {{ item.selling_plan_allocation.selling_plan.name | escape }}{% for option in item.selling_plan_allocation.selling_plan.options %} · {{ option.name | escape }} {{ option.value | escape }}{% endfor %}</p>
              {%- endif -%}
              {%- for discount in item.line_level_discount_allocations -%}
                <p class="cart-line-discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
              {%- endfor -%}
              <p class="cart-line-unit">{{ item.final_price | money }} each</p>
              <a class="cart-line-remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0" aria-label="Remove {{ item.product.title | escape }} from cart">Remove</a>
            </div>
            <div class="cart-line-qty">
              <label for="qty-{{ forloop.index }}">Qty</label>
              <input id="qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="Quantity for {{ item.product.title | escape }}">
            </div>
            <p class="cart-line-total">{{ item.final_line_price | money }}</p>
          </li>
        {%- endfor -%}
      </ul>
      <div class="cart-summary">
        <div class="cart-summary-rows">
          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="cart-summary-discount"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></p>
          {%- endfor -%}
          <p class="cart-summary-total"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></p>
        </div>
        <p class="cart-summary-note">Shipping and taxes are calculated at checkout.</p>
        <div class="cart-summary-actions">
          <button type="submit" class="button" name="checkout">Check out <span aria-hidden="true">↗</span></button>
          <button type="submit" class="button button-outline" name="update">Update cart</button>
        </div>
        {%- if sea_salt != blank -%}<a class="text-link cart-continue" href="{{ sea_salt.url }}">Keep shopping</a>{%- endif -%}
      </div>
    </form>
  {%- endif -%}
</section>
