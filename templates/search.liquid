{%- assign sea_salt = settings.product_sea_salt | default: all_products['aegean-sea-salt'] -%}
{%- assign herbs = settings.product_herbs | default: all_products['greek-garden-herbs'] -%}
<section class="section-wrap coming-soon-page">
  <p class="eyebrow">LOOKING FOR CHIPS?</p>
  <h1>You’re in the<br><em>right place.</em></h1>
  <p>Aegean Sea Salt and Greek Garden Herbs are available to order now in boxes of 6, 12 or 18 bags.</p>
  <div class="hero-actions">{% if sea_salt != blank and sea_salt.available and herbs != blank and herbs.available %}<a class="button" href="{{ routes.all_products_collection_url }}">Shop our chips <span aria-hidden="true">↗</span></a>{% elsif sea_salt != blank and sea_salt.available %}<a class="button" href="{{ sea_salt.url }}">Shop Aegean Sea Salt <span aria-hidden="true">↗</span></a>{% else %}<a class="button" href="{{ routes.root_url }}#chips">Meet the chips <span aria-hidden="true">↗</span></a>{% endif %}<a class="text-link" href="{{ routes.root_url }}#contact">Contact us</a></div>
</section>
