{%- assign sea_salt = settings.product_sea_salt | default: all_products['aegean-sea-salt'] -%}
<section class="section-wrap cart-page" aria-labelledby="collection-heading">
  <p class="eyebrow">OUR CHIPS</p>
  <h1 id="collection-heading">{{ collection.title | default: 'Sourdough pita crisps' | escape }}</h1>
  {%- if collection.products.size > 0 -%}
    <ul class="shop-grid">
      {%- for item in collection.products -%}
        <li class="shop-card{% if item.tags contains 'coming-soon' %} is-soon{% endif %}">
          <a class="shop-card-art product-art{% if item.tags contains 'flavor-herbs' %} product-art-herbs{% endif %}" href="{{ item.url }}">
            {%- if item.featured_image -%}<img src="{{ item.featured_image | image_url: width: 600 }}" alt="{{ item.featured_image.alt | escape }}" width="300" height="375" loading="lazy">{%- else -%}<img src="{{ 'zeus-aegean-sea-salt.webp' | asset_url }}" alt="" width="300" height="375" loading="lazy">{%- endif -%}
          </a>
          <h2 class="shop-card-title"><a href="{{ item.url }}">{{ item.title | escape }}</a></h2>
          {%- if item.tags contains 'coming-soon' or item.available == false -%}
            <p class="shop-card-price"><span class="soon-pill"><span aria-hidden="true">✦</span> Coming soon</span></p>
          {%- else -%}
            <p class="shop-card-price">From {{ item.price_min | money }}</p>
            <a class="button button-small" href="{{ item.url }}">Shop <span aria-hidden="true">↗</span></a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <div class="cart-empty">
      <p>Nothing to see here yet.</p>
      <div class="hero-actions">{% if sea_salt != blank %}<a class="button" href="{{ sea_salt.url }}">Shop Aegean Sea Salt <span aria-hidden="true">↗</span></a>{% endif %}<a class="text-link" href="{{ routes.root_url }}#chips">Meet the chips</a></div>
    </div>
  {%- endif -%}
</section>
