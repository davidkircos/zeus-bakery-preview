{%- liquid
  assign flavor = 'sea-salt'
  if product.tags contains 'flavor-herbs' or product.handle contains 'herb'
    assign flavor = 'herbs'
  endif
  assign coming_soon = false
  if product.tags contains 'coming-soon'
    assign coming_soon = true
  endif
  assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign sea_salt = settings.product_sea_salt | default: all_products['aegean-sea-salt']
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
  if flavor == 'herbs'
    assign eyebrow = 'MEET YOUR OTHER FAVORITE'
    assign title_line = 'Greek'
    assign title_accent = 'Garden Herbs.'
    assign art_class = 'product-art-herbs'
    assign fallback_image = 'zeus-greek-garden-herbs.webp' | asset_url
    assign fallback_alt = 'Greek Garden Herbs sourdough pita crisps, 5.7 ounce (162 gram) bag'
    assign fallback_copy = '<p>Our family sourdough, with a little more Greek flavor. Heritage Colorado grains, extra virgin olive oil, sea salt, and Greek herbs come together in a crisp with deep sourdough flavor.</p><p>Fermented for 24 hours and hand-baked in Colorado. Bring a bag to the mezze table, pair with your favorite dip, or enjoy every last herby crunch on its own.</p>'
  else
    assign eyebrow = 'OUR SIGNATURE FLAVOR'
    assign title_line = 'Aegean'
    assign title_accent = 'Sea Salt.'
    assign art_class = ''
    assign fallback_image = 'zeus-aegean-sea-salt.webp' | asset_url
    assign fallback_alt = 'Aegean Sea Salt sourdough pita crisps, 5.7 ounce (162 gram) bag'
    assign fallback_copy = '<p>Good sourdough takes time. Ours starts with our 50+ year-old family starter and ferments for 24 hours before we bake it to a golden, satisfying crunch.</p><p>A little tangy. Perfectly salty. Made with heritage Colorado grains, extra virgin olive oil, and sea salt. Ready for your favorite dip—or straight out of the bag.</p>'
  endif
  if coming_soon
    assign eyebrow = 'COMING SOON'
  endif
  if product.title contains 'Sea Salt' or product.title contains 'Garden Herbs'
    assign use_mapped_title = true
  else
    assign use_mapped_title = false
  endif
-%}
<section class="section-wrap buy-page" aria-labelledby="buy-heading">
  <nav class="buy-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><a href="{{ routes.root_url }}#chips">Our chips</a><span aria-hidden="true">/</span><span aria-current="page">{{ product.title | escape }}</span></nav>
  <div class="buy-grid">
    <div class="buy-art product-art {{ art_class }}">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 1000 }}" srcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 1000 }} 1000w, {{ product.featured_image | image_url: width: 1400 }} 1400w" sizes="(max-width: 900px) 90vw, 45vw" alt="{{ product.featured_image.alt | default: fallback_alt | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" fetchpriority="high">
      {%- else -%}
        <img src="{{ fallback_image }}" alt="{{ fallback_alt }}" width="1122" height="1402" fetchpriority="high">
      {%- endif -%}
      <span class="product-art-caption">{% if flavor == 'herbs' %}A LITTLE GREEK GARDEN IN EVERY BITE.{% else %}GREEK TRADITION. GOLDEN PERFECTION.{% endif %}</span>
    </div>
    <div class="buy-copy">
      <p class="eyebrow">{{ eyebrow }}</p>
      <h1 id="buy-heading" class="buy-title">{% if use_mapped_title %}{{ title_line }}<br><em>{{ title_accent }}</em>{% else %}{{ product.title | escape }}{% endif %}</h1>
      <p class="product-type">SOURDOUGH PITA CRISPS · 5.7 OZ (162 G) PER BAG</p>
      <div class="product-tags"><span>Vegan</span><span>Seed oil free</span><span>Hand-baked</span></div>

      {%- if coming_soon -%}
        <div class="buy-coming-soon">
          <span class="campaign-status">COMING SOON</span>
          <p>{{ product.title | escape }} is almost ready to leave the oven.{% if sea_salt != blank and sea_salt.handle != product.handle %} Aegean Sea Salt is available now.{% endif %}</p>
          <div class="hero-actions">
            {%- if sea_salt != blank and sea_salt.handle != product.handle -%}<a class="button" href="{{ sea_salt.url }}">Shop Aegean Sea Salt <span aria-hidden="true">↗</span></a>{%- endif -%}
            <a class="text-link" href="{{ routes.root_url }}#contact">Tell me when it’s here</a>
          </div>
        </div>
      {%- elsif product.available == false -%}
        <div class="buy-coming-soon">
          <span class="campaign-status">SOLD OUT</span>
          <p>We’re baking more. Check back soon or get in touch.</p>
          <div class="hero-actions"><a class="button" href="{{ routes.root_url }}#contact">Contact us <span aria-hidden="true">↗</span></a></div>
        </div>
      {%- else -%}
        {%- form 'product', product, id: 'zeus-buy-form', class: 'buy-form', data-currency: cart.currency.iso_code -%}
          <fieldset class="buy-options">
            <legend>{% if has_plans %}<span class="buy-step">1</span> {% endif %}Pick your box</legend>
            {%- for variant in product.variants -%}
              {%- liquid
                assign bags = variant.option1 | split: ' ' | first | plus: 0
                if bags < 1
                  assign bags = 1
                endif
                assign per_bag = variant.price | divided_by: bags
                assign save = 0
                if variant.compare_at_price > variant.price
                  assign save = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
                endif
                capture plans_json
                  echo '{'
                  for allocation in variant.selling_plan_allocations
                    unless forloop.first
                      echo ','
                    endunless
                    echo '"' | append: allocation.selling_plan.id | append: '":' | append: allocation.price
                  endfor
                  echo '}'
                endcapture
              -%}
              <label class="buy-option{% unless variant.available %} is-unavailable{% endunless %}">
                <input type="radio" name="id" value="{{ variant.id }}"{% if variant.id == selected_variant.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %} data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price }}" data-bags="{{ bags }}" data-plans='{{ plans_json }}'>
                <span class="buy-option-body">
                  <span class="buy-option-title">{{ variant.title | escape }}</span>
                  <span class="buy-option-price">{{ variant.price | money }}</span>
                  <span class="buy-option-meta">{% if variant.available %}{{ per_bag | money }} per bag{% if save > 0 %} <b class="buy-save">Save {{ save }}%</b>{% endif %}{% else %}Sold out{% endif %}</span>
                </span>
              </label>
            {%- endfor -%}
          </fieldset>

          {%- if has_plans -%}
            <fieldset class="buy-options buy-plans">
              <legend><span class="buy-step">2</span> How often?</legend>
              {%- unless product.requires_selling_plan -%}
                <label class="buy-option">
                  <input type="radio" name="purchase_option" value="" checked>
                  <span class="buy-option-body"><span class="buy-option-title">One-time purchase</span><span class="buy-option-meta">Ships once. No strings attached.</span></span>
                </label>
              {%- endunless -%}
              {%- for group in product.selling_plan_groups -%}
                {%- for plan in group.selling_plans -%}
                  {%- liquid
                    assign adjustment = plan.price_adjustments | first
                    assign plan_save = ''
                    if adjustment.value_type == 'percentage' and adjustment.value > 0
                      assign plan_save = 'Save ' | append: adjustment.value | append: '%'
                    elsif adjustment.value_type == 'fixed_amount' and adjustment.value > 0
                      assign plan_amount = adjustment.value | money
                      assign plan_save = 'Save ' | append: plan_amount
                    endif
                  -%}
                  <label class="buy-option buy-option-plan">
                    <input type="radio" name="purchase_option" value="{{ plan.id }}"{% if product.requires_selling_plan and forloop.first and forloop.parentloop.first %} checked{% endif %}>
                    <span class="buy-option-body">
                      <span class="buy-option-title">{% if group.selling_plans.size == 1 %}{{ group.name | escape }}{% else %}{{ plan.name | escape }}{% endif %}{% if plan_save != '' %} <b class="buy-save">{{ plan_save }}</b>{% endif %}</span>
                      <span class="buy-option-meta">{% if plan.description != blank %}{{ plan.description | escape }}{% else %}{% for option in plan.options %}{{ option.value | escape }}{% unless forloop.last %} · {% endunless %}{% endfor %}{% endif %} · Cancel anytime.</span>
                    </span>
                  </label>
                {%- endfor -%}
              {%- endfor -%}
            </fieldset>
            <input type="hidden" name="selling_plan" value="" disabled>
          {%- endif -%}

          {%- liquid
            assign sel_bags = selected_variant.option1 | split: ' ' | first | plus: 0
            if sel_bags < 1
              assign sel_bags = 1
            endif
            assign sel_save = 0
            if selected_variant.compare_at_price > selected_variant.price
              assign sel_save = selected_variant.compare_at_price | minus: selected_variant.price | times: 100.0 | divided_by: selected_variant.compare_at_price | round
            endif
          -%}
          <div class="buy-summary">
            <div class="buy-price">
              <span class="buy-price-now" data-price-now>{{ selected_variant.price | money }}</span>
              <s class="buy-price-was" data-price-was{% unless sel_save > 0 %} hidden{% endunless %}>{{ selected_variant.compare_at_price | money }}</s>
              <span class="buy-price-save" data-price-save{% unless sel_save > 0 %} hidden{% endunless %}>Save {{ sel_save }}%</span>
            </div>
            <p class="buy-price-per" data-price-per>{{ selected_variant.price | divided_by: sel_bags | money }} per bag · {{ selected_variant.title | escape }}</p>
            <div class="buy-actions">
              <button type="submit" class="button buy-add">Add to cart <span aria-hidden="true">↗</span></button>
              <button type="submit" class="button button-outline buy-now" name="return_to" value="/checkout">Buy now</button>
            </div>
            <p class="buy-note"><span aria-hidden="true">✦</span> Hand-baked in Colorado. Shipping calculated at checkout.</p>
          </div>
        {%- endform -%}
      {%- endif -%}

      <div class="buy-description">{% if product.description != blank %}{{ product.description }}{% else %}{{ fallback_copy }}{% endif %}</div>
    </div>
  </div>
  <div class="buy-details">
    {%- render 'zeus-nutrition', flavor: flavor, open: true -%}
  </div>
</section>
{% schema %}
{
  "name": "Zeus product page",
  "settings": []
}
{% endschema %}
