    <section class="about-section section-wrap" id="about" aria-labelledby="about-heading">
      <div class="section-top"><p class="eyebrow">A FAMILY RECIPE. A NEW CHAPTER.</p><span class="section-number" aria-hidden="true">02 / OUR STORY</span></div>
      <div class="about-grid"><figure class="family-photo"><img src="{{ 'family-pita-cleaned.jpg' | asset_url }}" alt="A tall stack of freshly baked Greek pita from the Kircos family bakery" width="1086" height="1448" loading="lazy"><figcaption>Greek pita from our family bakery.</figcaption></figure><div class="about-copy"><h2 id="about-heading">{{ section.settings.heading_first | escape }}<br><em>{{ section.settings.heading_second | escape }}</em></h2>{{ section.settings.story }}<span class="family-signoff">From our family to your table.</span><div class="family-route" aria-label="Our journey: Greece, Detroit, Colorado"><span>GREECE</span><i aria-hidden="true"></i><span>DETROIT</span><i aria-hidden="true"></i><span>COLORADO</span></div></div></div>
